# AICONEKT TECHNOLOGIES — Environment Configuration Template
# Copy this file to .env and configure credentials for local development or production.
# NEVER commit your actual .env file or production secrets to source control.

PORT=3001
NODE_ENV=development

# Authentication & Cryptography
# Generate a cryptographically secure random secret (min 32 characters)
# Example: openssl rand -base64 32
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_here

# Initial Founder / Administrator Setup
# Used to seed initial accounts on first database initialization
INITIAL_FOUNDER_PASSWORD=your_secure_initial_founder_password_here
INITIAL_MANAGER_PASSWORD=your_secure_initial_manager_password_here

# Transactional Email Notification Configuration (Optional)
# Inquiries are automatically saved in the database regardless of SMTP status.
# If configured, notifications will be delivered to the specified recipient.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
NOTIFICATION_RECIPIENT=your_contact_email_here

# Database Path (Default persistent SQLite in data/ directory)
DATABASE_PATH=./data/aiconekt.db
